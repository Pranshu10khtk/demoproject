<% layout("/layouts/boilerplate") %>
    <h1>Edit your Listing</h1>

    <form class="edit-listing-form" method="POST" action="/listings/<%= foundListing._id %>?_method=PUT">

        <div class="edit-listing-field">
        <label for="title">Title</label>
        <input
            id="title"
            name="listing[title]"
            value="<%= foundListing.title %>"
            placeholder="Enter the title"
            type="text"
        >
        </div>

        <div class="edit-listing-field">
        <label for="description">Description</label>
        <textarea
            id="description"
            name="listing[description]"
            placeholder="Enter the description"
        ><%= foundListing.description %></textarea>
        </div>

        <div class="edit-listing-field">
        <label for="image">Image Link</label>
        <input
            id="image"
            name="listing[image]"
            value="<%= foundListing.image %>"
            placeholder="Enter image URL/link"
            type="text"
        >
        </div>

        <div class="edit-listing-row">
        <div class="edit-listing-field">
        <label for="price">Price</label>
        <input
            id="price"
            name="listing[price]"
            value="<%= foundListing.price %>"
            placeholder="Enter the price"
            type="number"
        >
        </div>

        <div class="edit-listing-field">
        <label for="country">Country</label>
        <input
            id="country"
            name="listing[country]"
            value="<%= foundListing.country %>"
            placeholder="Enter the country"
            type="text"
        >
        </div>
        </div>

        <div class="edit-listing-field">
        <label for="location">Location</label>
        <input
            id="location"
            name="listing[location]"
            value="<%= foundListing.location %>"
            placeholder="Enter the location"
            type="text"
        >
        </div>

       <button type="submit" class="btn edit-btn">Edit</button>

    </form>
    </main>

</body>
</html>

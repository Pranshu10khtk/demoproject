<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sarai</title>
</head>

<body>

    <h1>Edit Listing</h1>

    <form method="POST" action="/listings/<%= foundListing._id %>?_method=PUT">

        <input
            name="listing[title]"
            value="<%= foundListing.title %>"
            placeholder="enter the title"
            type="text"
        >
        <br>

        <textarea
            name="listing[description]"
            placeholder="enter the description"
        ><%= foundListing.description %></textarea>
        <br>

        <input
            name="listing[image]"
            value="<%= foundListing.image %>"
            placeholder="enter image URL/link"
            type="text"
        >
        <br>

        <input
            name="listing[price]"
            value="<%= foundListing.price %>"
            placeholder="enter the price"
            type="number"
        >
        <br>

        <input
            name="listing[location]"
            value="<%= foundListing.location %>"
            placeholder="enter the location"
            type="text"
        >
        <br>

        <input
            name="listing[country]"
            value="<%= foundListing.country %>"
            placeholder="enter the country"
            type="text"
        >
        <br>

        <button type="submit">Edit Listing</button>

    </form>

</body>
</html>
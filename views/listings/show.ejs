<% layout("layouts/boilerplate") %>

    <h3>Listing Details :</h3>

    <ul>
        <li><%= foundListing.title %></li>
        <li><%= foundListing.description %></li>
        <li>&#8377; <%= foundListing.price.toLocaleString("en-IN") %></li>
        <li><%= foundListing.location %></li>
        <li><%= foundListing.country %></li>
    </ul>
    <br>
  <a href="/listings/<%= foundListing._id %>/edit">Edit this listing</a>
  <form method="POST" action="/listings/<%= foundListing._id %>?_method=DELETE">
    <button type="submit">Delete</button>
</form>


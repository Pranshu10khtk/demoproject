<% layout("layouts/boilerplate") %>

  <main class="show-listing-page">
    <a href="/listings" class="back-link">&larr; Back to listings</a>

    <div class="show-listing-card">
      <div class="show-listing-image-wrap">
        <img
          src="<%= foundListing.image.url %>"
          class="show-listing-image"
          alt="<%= foundListing.title %>"
        >
      </div>

      <div class="show-listing-content">
        <p class="show-listing-location"><%= foundListing.location %>, <%= foundListing.country %></p>
        <h1><%= foundListing.title %></h1>
        <p class="show-listing-description"><%= foundListing.description %></p>

        <div class="show-listing-price">
          <strong>&#8377; <%= foundListing.price.toLocaleString("en-IN") %></strong>
          <span> / night</span>
        </div>

        <div class="show-listing-actions">
          <a href="/listings/<%= foundListing._id %>/edit" class="btn btn-dark">Edit listing</a>
          <form method="POST" action="/listings/<%= foundListing._id %>?_method=DELETE">
            <button type="submit" class="btn btn-outline-danger">Delete listing</button>
          </form>
        </div>
      </div>
    </div>
  </main>


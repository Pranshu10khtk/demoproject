<% layout("layouts/boilerplate") %>

<div class="new-listing-container">
    <a href="/listings" class="back-link">&larr; Back to listings</a>
    <h1>Create a New Listing</h1>
    <p class="new-listing-intro">Add the details of your place and make it available to guests.</p>

    <% if (typeof error !== "undefined") { %>
        <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <form method="POST" action="/listings" class="new-listing-form needs-validation" novalidate>
        <div class="new-listing-field">
            <label for="title" class="form-label">Title</label>
            <input id="title" name="listing[title]" placeholder="Enter the listing title" type="text" class="form-control" required />
            <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <div class="new-listing-field">
            <label for="description" class="form-label">Description</label>
            <textarea id="description" name="listing[description]" placeholder="Describe your place" class="form-control" rows="5" required></textarea>
        </div>

        <div class="new-listing-field">
            <label for="image" class="form-label">Image</label>
            <input id="image" name="listing[image][url]" placeholder="Paste an image URL" type="url" class="form-control">
        </div>

        <div class="new-listing-row">
            <div class="new-listing-field">
                <label for="price" class="form-label">Price per night</label>
                    <input id="price" name="listing[price]" placeholder="Enter price" type="number" min="0" class="form-control" required>
                        <div class="invalid-feedback">Please enter a valid price.</div>
            </div>

            <div class="new-listing-field">
                <label for="location" class="form-label">Location</label>
                <input id="location" name="listing[location]" placeholder="Enter location" type="text" class="form-control" required>
                <div class="invalid-feedback">Please enter a location.</div>
            </div>

            <div class="new-listing-field">
                <label for="country" class="form-label">Country</label>
                <input id="country" name="listing[country]" placeholder="Enter country" type="text" class="form-control" required>
                <div class="invalid-feedback">Please enter a country.</div>
            </div>
        </div>

        <button type="submit" class="add-listing-btn">Add</button>
    </form>
</div>
    
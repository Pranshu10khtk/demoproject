<% layout("layouts/boilerplate") %>

<main class="error-page text-center py-5">
    <p class="text-muted mb-2">Error <%= statusCode || 404 %></p>
    <h1 class="display-4"><%= statusCode === 404 ? "Page Not Found" : "Server Error" %></h1>
    <p class="lead"><%= message %></p>
    <a href="/listings" class="btn btn-dark mt-3">View all listings</a>
</main>
